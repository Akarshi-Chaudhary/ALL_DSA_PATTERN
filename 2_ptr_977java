// good approch 

class Solution{
    public int[] sortedSquares(int[] nums){
        int n  = nums.length;
        int[] ans =  new int[n];
        int l = 0, r = n - 1, pos = n - 1;

        while(l <= r){
            int lsq = nums[l] * nums[l];
            int rsq = nums[r] * nums[r];
            if(lsq > rsq){
                ans[pos] = lsq;
                l++;    
            }
            else{
                ans[pos] = rsq;
                r--;    
            }
             pos--;  
        }
        return ans;
    }
}
